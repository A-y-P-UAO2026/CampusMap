d": true, "inCaption": true, "browsable": true, "editMode": "advanced", "name": "Espacios Deportivos y Culturales", "remoteData": {}, "id": "cbaa6e1e-815c-48ca-b731-5ff7f56ae414", "permissions": {"edit_status": 2}, "type": "Cluster", "cluster": {"radius": 100}}, "properties": {"name": "Espacios Deportivos y Culturales", "type": "Cluster", "cluster": {"radius": 100}, "editMode": "advanced", "browsable": true, "inCaption": true, "remoteData": {}, "permissions": {"edit_status": 2}, "displayOnLoad": true}}, {"type": "FeatureCollection", "features": [{"type": "Feature", "geometry": {"type": "Point", "coordinates": [-76.520784, 3.353495]}, "properties": {"_umap_options": {"color": "Gold", "iconUrl": "/uploads/pictogram/restaurant.svg", "showLabel": null, "popupShape": "Large", "iconClass": "Drop"}, "name": "Cafeter\u00edas", "description": "{{https://i.imgur.com/OYV0Mln.jpeg}}\n**Primer Piso**\n- Escaladas Caf\u00e9.\n- Petete\u00b4s.\n- Caffesabor.\n- Inajar.\n**Segundo Piso**\n- Green Point.\n**Tercer Piso**\n- Mr. Fruit & Gourmet.\n\n [[https://sitios.uao.edu.co/cafeterias/|Mas informaci\u00f3n. ]]\n\n"}, "id": "UxMzc"}, {"type": "Feature", "geometry": {"type": "Point", "coordinates": [-76.520924, 3.353217]}, "properties": {"_umap_options": {"color": "Sienna", "iconClass": "Drop", "iconUrl": "/uploads/pictogram/theatre.svg", "showLabel": null, "popupShape": "Large"}, "name": "Espacios de actividades Bienestar", "description": "{{https://i.imgur.com/NVcY8aP.jpeg}}\n**Primer Piso**\n- Sal\u00f3n Talleres Corporales. \n- Sal\u00f3n de Actividades. \n- Sala Ac\u00fastica. \n**Segundo Piso**\n- Sal\u00f3n CEA. \n- Sal\u00f3n de Ajedrez. \n- Almac\u00e9n de Deportes. \n"}, "id": "Y2MjA"}, {"type": "Feature", "geometry": {"type": "Point", "coordinates": [-76.520695, 3.35315]}, "properties": {"_umap_options": {"iconUrl": "/uploads/pictogram/computer.svg", "color": "Grey", "showLabel": null, "iconClass": "Drop", "popupShape": "Panel"}, "name": "Oficinas Bienestar", "description": "{{https://i.imgur.com/uuLo9jm.jpg}}\n**Primer Piso**\n- Centro Para la Excelencia Acad\u00e9mica.  \n- Servicios Para Cr\u00e9ditos Institucionales. \n- Centro de Atenci\u00f3n, Servicios y Acompa\u00f1amiento, CASA.\n- Enfermer\u00eda.  \n**Segundo Piso**\n- Gesti\u00f3n de la Informaci\u00f3n de Bienestar. \n- Departamento de Deporte y Recreaci\u00f3n. \n- Departamento de Cultura. \n- Direcci\u00f3n Bienestar Universitario. \n**Tercer Piso**\n- Desarrollo Humano. \n- Organizaci\u00f3n de Grupos Estudiantiles OGE. \n- Comisi\u00f3n de \u00c9tica. \n- Cooaut\u00f3noma. \n- Banco del Afecto. \n- Coordinaci\u00f3n Desarrollo Psicosocial. \n- Plan Padrino.  "}, "id": "M2NDM"}], "_umap_options": {"displayOnLoad": true, "inCaption": true, "browsable": true, "editMode": "advanced", "name": "Bienestar Universitario", "remoteData": {}, "type": "Cluster", "cluster": {"radius": 80}, "choropleth": {}, "id": "c4ad8695-0459-457d-9780-4e679affc51f", "permissions": {"edit_status": 0}}, "properties": {"name": "Bienestar Universitario", "type": "Cluster", "cluster": {"radius": 80}, "editMode": "advanced", "browsable": true, "inCaption": true, "choropleth": {}, "remoteData": {}, "permissions": {"edit_status": 0}, "displayOnLoad": true}}, {"type": "FeatureCollection", "features": [{"type": "Feature", "geometry": {"type": "Polygon", "coordinates": [[[-76.520022, 3.354173], [-76.520028, 3.353939], [-76.51991, 3.353926], [-76.51981, 3.353915], [-76.519805, 3.354004], [-76.5198, 3.354055], [-76.519802, 3.354092], [-76.5198, 3.354151], [-76.520022, 3.354173]]]}, "properties": {"_umap_options": {"opacity": 0.1, "fillColor": "SlateGray"}, "name": "Lab. Prototipado"}, "id": "k1MzM"}, {"type": "Feature", "geometry": {"type": "Point", "coordinates": [-76.522364, 3.353648]}, "properties": {"_umap_options": {"color": "FireBrick", "iconClass": "Drop", "iconUrl": "https://img.icons8.com/?size=100&id=Im8npXfB6ZSK&format=png&color=FFFFFF", "showLabel": null, "popupShape": "Panel", "labelInteracti